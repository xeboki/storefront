# ─── Xeboki Storefront environment ───────────────────────────────────────────
# Copy to .env.local for local dev. The API is always LIVE (never mocked).

# API base — the gateway. SDK default is https://api.xeboki.com; leave unset in prod.
XEBOKI_API_BASE_URL=https://api.xeboki.com

# Multi-tenant routing
NEXT_PUBLIC_BASE_DOMAIN=xeboki.store
# Local dev only: which store to serve on localhost (or use ?store=slug)
NEXT_PUBLIC_DEV_STORE_SLUG=
# Public site origin, used in emails and canonical URLs
NEXT_PUBLIC_SITE_URL=https://xeboki.store

# Per-store API key (server-side only). One per slug: STORE_KEY_<SLUG_UPPER>=xbk_live_...
# STORE_KEY_MY_SHOP=xbk_live_...

# Customer session cookie signing (any strong secret)
STOREFRONT_JWT_SECRET=

# ─── Transactional email (P0) ────────────────────────────────────────────────
# Order confirmations send when these are set; otherwise sending is skipped.
RESEND_API_KEY=
EMAIL_FROM=Orders <orders@your-domain.com>
EMAIL_REPLY_TO=

# ─── Payments ────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ─── Analytics (P0) — optional, set per deployment or per-store config ────────
# Fallbacks if a store hasn't set its own ids in storefront config.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Rate limiting at scale (P2) ──────────────────────────────────────────────
# When set, the middleware limiter uses Upstash instead of per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
